# Copy to .env and fill in. NEVER commit .env. Generate secrets with: npm run gen:secrets
NODE_ENV=development
PORT=3000
DB_PATH=./data/salama.db

# >= 32 chars, random
JWT_SECRET=
# exactly 64 hex chars (32 bytes) - encrypts MFA secrets at rest (AES-256-GCM)
MFA_ENC_KEY=

SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# comma-separated role keys that MUST enrol in MFA before using the API
MFA_REQUIRED_ROLES=system_administrator,principal_investigator,data_manager_analyst
COOKIE_SECURE=true

# used only by `npm run seed:admin`
ADMIN_USERNAME=
ADMIN_PASSWORD=
